---
import type { Kind } from "@clawforge/schema";
import CopyableCommand from "../../components/CopyableCommand.astro";
import EntryCard from "../../components/EntryCard.astro";
import Base from "../../layouts/Base.astro";
import { getIndex, kindDirName } from "../../lib/registry.ts";

export function getStaticPaths() {
  const entries = getIndex().entries;
  return entries.map((entry) => ({
    params: { kind: entry.kind, slug: entry.name },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const all = getIndex().entries;
const related = all
  .filter(
    (e) =>
      e.id !== entry.id &&
      (e.category === entry.category || e.tags.some((t) => entry.tags.includes(t))),
  )
  .slice(0, 3);
const kindDir = kindDirName(entry.kind as Kind);
const sourceUrl = `https://github.com/kalkan/clawforge/tree/main/registry/${kindDir}/${entry.name}`;
---

<Base title={`${entry.displayName} — clawforge`} description={entry.description}>
  <section class="py-8">
    <p class="mb-2 text-xs text-zinc-500">
      <a href="/browse" class="hover:text-brand">browse</a>
      <span>›</span>
      <span class="font-mono">{entry.kind}</span>
      <span>›</span>
      <span class="font-mono">{entry.category}</span>
    </p>

    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-4xl font-bold">{entry.displayName}</h1>
      {
        entry.verified && (
          <span class="rounded bg-emerald-500/10 px-2 py-1 text-sm text-emerald-500">
            ✓ Verified
          </span>
        )
      }
    </div>

    <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">{entry.description}</p>

    <p class="mt-2 text-sm text-zinc-500">
      by <span class="text-brand">@{entry.author}</span>
      · <span class="font-mono">v{entry.version}</span>
      · updated {entry.updatedAt.slice(0, 10)}
    </p>
  </section>

  <section class="mb-8">
    <CopyableCommand command={`npx clawforge add ${entry.id}`} />
  </section>

  <section class="mb-8 flex flex-wrap gap-2">
    {
      entry.tags.map((t) => (
        <span class="rounded bg-zinc-100 px-2 py-1 text-xs text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
          #{t}
        </span>
      ))
    }
  </section>

  <section class="mb-8 rounded-lg border border-zinc-200 p-6 dark:border-zinc-800">
    <h2 class="mb-3 text-lg font-semibold">Metadata</h2>
    <dl class="grid grid-cols-[auto,1fr] gap-x-4 gap-y-2 text-sm">
      <dt class="text-zinc-500">ID</dt>
      <dd class="font-mono">{entry.id}</dd>
      <dt class="text-zinc-500">Kind</dt>
      <dd class="font-mono">{entry.kind}</dd>
      <dt class="text-zinc-500">Category</dt>
      <dd>{entry.category}</dd>
      <dt class="text-zinc-500">sha256</dt>
      <dd class="truncate font-mono text-xs" title={entry.sha256}>{entry.sha256}</dd>
      <dt class="text-zinc-500">Source</dt>
      <dd>
        <a href={sourceUrl} class="text-brand hover:underline">github.com/kalkan/clawforge</a>
      </dd>
    </dl>
  </section>

  {
    related.length > 0 && (
      <section class="mb-8">
        <h2 class="mb-4 text-xl font-semibold">Related</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((r) => (
            <EntryCard entry={r} />
          ))}
        </div>
      </section>
    )
  }
</Base>
