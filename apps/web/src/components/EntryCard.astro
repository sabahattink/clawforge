---
import type { IndexEntry } from "@clawforge/schema";

interface Props {
  entry: IndexEntry;
}

const { entry } = Astro.props;
const href = `/${entry.kind}/${entry.name}/`;
---

<a
  href={href}
  class="group block rounded-xl border border-zinc-200 bg-white p-5 transition hover:border-brand hover:shadow-lg dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-brand"
>
  <div class="flex items-start justify-between gap-2">
    <div class="flex items-center gap-2">
      <span
        class="rounded bg-zinc-100 px-2 py-0.5 font-mono text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400"
        >{entry.kind}</span
      >
      {
        entry.verified && (
          <span
            class="rounded bg-emerald-500/10 px-2 py-0.5 text-xs text-emerald-500"
            title="Verified"
          >
            ✓ verified
          </span>
        )
      }
    </div>
    <span class="font-mono text-xs text-zinc-400">v{entry.version}</span>
  </div>
  <h3 class="mt-3 font-semibold group-hover:text-brand">{entry.displayName}</h3>
  <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{entry.description}</p>
  <div class="mt-3 flex flex-wrap gap-1 text-xs text-zinc-500">
    {entry.tags.map((t) => <span class="rounded bg-zinc-100 px-2 py-0.5 dark:bg-zinc-800">{t}</span>)}
  </div>
</a>
