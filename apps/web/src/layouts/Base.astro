---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "clawforge", description = "The registry for Claude Code." } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      const stored = localStorage.getItem("clawforge-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const isDark = stored === null ? prefersDark : stored === "dark";
      document.documentElement.classList.toggle("dark", isDark);
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <Nav />
    <main class="mx-auto max-w-6xl px-6 pb-24 pt-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
